# Base class (Parent)
class Animal:
    def eat(self):
        print("animal eat")

# Intermediate class (Child of Animal)
class Mammals(Animal):
    def sleep(self):
        print("mammals sleep")

# Derived class (Child of Mammals, Grandchild of Animal)
class Dog(Mammals):
    def sound(self):
        print("dog sound")

# --- Completing the code by demonstrating its usage ---

# Create an instance of the Dog class
my_dog = Dog()

# Calling methods from all levels of the inheritance chain
my_dog.eat()    # Inherited from Animal
my_dog.sleep()  # Inherited from Mammals
my_dog.sound()  # Defined in Dog
