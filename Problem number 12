class Demo:
    a = 1
    b = 2

    def abc(self):
        print("abc")

class sample(Demo):
    c = 3
    d = 4

    def cde(self):
        print("cde")

# Creating an instance of the child class
s = sample()

# Printing attributes
print(s.a)
print(s.b)
print(s.c)
print(s.d)

# Calling methods
s.abc()
s.cde()
